@using LibTeam.Models
@model List<TuaSach>

@{
    ViewData["Title"] = "Quản lý Tựa Sách";
}

<!-- Header + Breadcrumb -->
<div class="row mb-2">
    <div class="col-sm-6">
        <h1>@ViewData["Title"]</h1>
    </div>
    <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li class="breadcrumb-item active">Danh sách tựa sách</li>
        </ol>
    </div>
</div>

<!-- Tools: Search + Add -->
<div class="row mb-3">
    <div class="col-sm-8">
        <form class="form-inline" method="get">
            <input type="text" name="search" class="form-control mr-2"
                   placeholder="Tìm tựa sách..." value="@ViewBag.Search" />
            <button type="submit" class="btn btn-success">
                <i class="fas fa-search"></i> Tìm kiếm
            </button>
        </form>
    </div>
    <div class="col-sm-4 text-right">
        <button class="btn btn-primary" onclick="openAddModal()">
            <i class="fas fa-plus"></i> Thêm tựa sách
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tên tựa sách</th>
                    <th>Mô tả</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ts in Model)
                {
                    <tr>
                        <td>@ts.TuaSachID</td>
                        <td>@ts.TenTuaSach</td>
                        <td>@ts.MoTa</td>
                        <td>
                            <button class="btn btn-primary btn-sm"
                                    onclick="openEditModal(@ts.TuaSachID)">
                                <i class="fas fa-edit"></i> Sửa
                            </button>
                            <button class="btn btn-danger btn-sm"
                                    onclick="deleteTuaSach(@ts.TuaSachID)">
                                <i class="fas fa-trash"></i> Xóa
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    <div class="card-footer clearfix">
        <ul class="pagination pagination-sm m-0 float-right">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, search = ViewBag.Search })">
                    &laquo;
                </a>
            </li>
            @for (int i = 1; i <= (int)Math.Ceiling((double)ViewBag.TotalItems / ViewBag.PageSize); i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       href="@Url.Action("Index", new { page = i, search = ViewBag.Search })">@i</a>
                </li>
            }
            <li class="page-item @(ViewBag.CurrentPage == (int)Math.Ceiling((double)ViewBag.TotalItems / ViewBag.PageSize) ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, search = ViewBag.Search })">
                    &raquo;
                </a>
            </li>
        </ul>
    </div>
</div>

<!-- Modal Thêm/Sửa -->
<div class="modal fade" id="tuaSachModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle"></h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>

            <div class="modal-body">
                <!-- Form Create -->
                <form id="createForm" style="display:none;" method="post">
                    <div class="form-group">
                        <label for="TenTuaSach">Tên tựa sách:</label>
                        <input type="text" name="TenTuaSach" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label for="MoTa">Mô tả:</label>
                        <textarea name="MoTa" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary">Thêm</button>
                    </div>
                </form>

                <!-- Form Edit -->
                <form id="editForm" style="display:none;" method="post">
                    <input type="hidden" name="TuaSachID" id="TuaSachID" />
                    <div class="form-group">
                        <label for="TenTuaSach">Tên tựa sách:</label>
                        <input type="text" name="TenTuaSach" id="TenTuaSach" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label for="MoTa">Mô tả:</label>
                        <textarea name="MoTa" id="MoTa" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary">Cập nhật</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>

    <script>
        function openAddModal() {
            $('#modalTitle').text('Thêm tựa sách');
            $('#editForm').hide();
            $('#createForm').show().trigger('reset');
            $('#createForm').attr('action', '@Url.Action("Create", "TuaSach")');
            $('#tuaSachModal').modal('show');
        }

        function openEditModal(id) {
            $('#createForm').hide();
            $('#editForm').show();
            $('#modalTitle').text('Chỉnh sửa tựa sách');
            $.get('@Url.Action("Details", "TuaSach")', { id }, function(res) {
                if (!res.success) { toastr.error(res.message); return; }
                $('#TuaSachID').val(res.tuaSachID);
                $('#TenTuaSach').val(res.tenTuaSach);
                $('#MoTa').val(res.moTa);
                $('#editForm').attr('action', '@Url.Action("Edit", "TuaSach")?id=' + res.tuaSachID);
                $('#tuaSachModal').modal('show');
            });
        }

        function deleteTuaSach(id) {
            if (!confirm('Bạn có chắc muốn xóa tựa sách này?')) return;
            $.post('@Url.Action("DeleteConfirmed", "TuaSach")', { id }, function(res) {
                if (res.success) {
                    toastr.success(res.message);
                    setTimeout(() => location.reload(), 800);
                } else {
                    toastr.error(res.message);
                }
            });
        }

        $('#createForm').validate({
            rules: { TenTuaSach: "required", MoTa: "required" },
            messages: {
                TenTuaSach: "Vui lòng nhập tên tựa sách",
                MoTa: "Vui lòng nhập mô tả"
            },
            submitHandler: function(form) {
                var $f = $(form), url = $f.attr('action');
                $.post(url, $f.serialize(), function(res) {
                    if (res.success) {
                        toastr.success(res.message);
                        $('#tuaSachModal').modal('hide');
                        setTimeout(() => location.reload(), 800);
                    } else toastr.error(res.message);
                });
                return false;
            }
        });

        $('#editForm').validate({
            rules: { TenTuaSach: "required", MoTa: "required" },
            messages: {
                TenTuaSach: "Vui lòng nhập tên tựa sách",
                MoTa: "Vui lòng nhập mô tả"
            },
            submitHandler: function(form) {
                var $f = $(form), url = $f.attr('action');
                $.post(url, $f.serialize(), function(res) {
                    if (res.success) {
                        toastr.success(res.message);
                        $('#tuaSachModal').modal('hide');
                        setTimeout(() => location.reload(), 800);
                    } else toastr.error(res.message);
                });
                return false;
            }
        });
    </script>
}
